---
import { correctionUrl, legalPages } from '~/config/legal';
interface Props { page: 'about' | 'privacy-policy' | 'terms-of-service' | 'copyright' | 'contact'; }
const content = legalPages[Astro.props.page];
---
<p>{content.intro}</p>
{content.sections.map((section) => <section><h2>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}
<p><a href={correctionUrl} target="_blank" rel="noopener noreferrer">Report a correction or contact the wiki on GitHub</a></p>
